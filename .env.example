# Copy to .env.local and fill in. Billing app configuration.
DATABASE_URL=file:./data/billing.db
# DATABASE_AUTH_TOKEN=   # only for a remote Turso/libSQL database

# Used to sign public invoice share links.
AUTH_SECRET=change-me-to-a-long-random-string

# First admin account created by `npm run db:seed`.
ADMIN_NAME=Administrator
ADMIN_EMAIL=admin@unnatigreenenergy.com
ADMIN_PASSWORD=Admin@12345

# Public base URL used in invoice share links.
APP_URL=http://localhost:3000
